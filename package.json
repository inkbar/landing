{
  "name": "@inkbar/landing",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321 --ignore-lock",
    "typecheck": "astro check",
    "test:browser": "playwright test",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "og": "node scripts/make-og.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,css,json,yml,yaml,md,mdx,astro,svelte}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^20.0.0",
    "@ecssc/commitlint-config": "^0.0.5",
    "@ecssc/eslint-config": "^1.0.2",
    "@ecssc/prettier-config": "^0.1.3",
    "@playwright/test": "1.62.1",
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.0",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "starlight-links-validator": "^0.27.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "astro": "^7.3.8",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2"
  }
}
