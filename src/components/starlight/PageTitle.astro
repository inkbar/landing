---
import Default from '@astrojs/starlight/components/PageTitle.astro'

import { agentNote, siteUrl } from '../../lib/markdown-twin'

// Only docs pages carry the note for agents; Starlight renders any other page through here too.
const { id } = Astro.locals.starlightRoute.entry
const isDocsPage = id === 'docs' || id.startsWith('docs/')
---

<Default>
  <slot />
</Default>
{isDocsPage && (
  <p class="sr-only" aria-hidden="true" data-agent-note>
    {agentNote(siteUrl(import.meta.env.BASE_URL))}
  </p>
)}
