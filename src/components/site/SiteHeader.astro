---
import { getCollection } from 'astro:content'

import { url } from '../../lib/url'
import Logo from './Logo.astro'

interface Props {
  variant?: 'landing' | 'docs'
}

const { variant = 'landing' } = Astro.props

const GITHUB = 'https://github.com/inkbar/inkbar'
// Pages only: a link to a section of the home page throws a reader on any other page back to
// it. The changelog joins once it has notes, as in the footer.
const hasChangelog = (await getCollection('changelog')).length > 0
const links = [
  { label: 'Docs', href: url('/docs/'), on: ['landing', 'docs'] },
  { label: 'Use cases', href: url('/use-cases/'), on: ['landing', 'docs'] },
  ...(hasChangelog
    ? [{ label: 'Changelog', href: url('/changelog/'), on: ['landing', 'docs'] }]
    : []),
  { label: 'Sandbox', href: 'https://sandbox.inkbar.dev', on: ['landing'] },
  { label: 'Get started', href: url('/docs/quickstart/'), on: ['landing'] },
].filter((link) => link.on.includes(variant))
---

<div class="site-header" data-variant={variant}>
  <a class="home" href={url('/')} aria-label="Inkbar home">
    <Logo />
  </a>
  <div class="search">
    <slot name="search" />
  </div>
  <nav aria-label="Site">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={variant === 'docs' && link.label === 'Docs' ? 'page' : undefined}
        class:list={{ strong: link.label === 'Get started' }}
      >
        {link.label}
      </a>
    ))}
    <a class="github" href={GITHUB}>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
      </svg>
      <span class="label">GitHub</span>
    </a>
  </nav>
</div>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    width: 100%;
  }
  .site-header[data-variant='landing'] {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 20px var(--gutter);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .search {
    flex: 1 1 240px;
    max-width: 420px;
  }
  .site-header[data-variant='landing'] .search {
    display: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
    font-size: 15px;
    font-weight: 500;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--ballpoint);
  }
  /* GitHub is its logo on a wide screen, with the word kept for screen readers, and the word
     on a phone, where the links wrap and an icon alone reads as decoration. */
  .github {
    justify-content: center;
    min-width: 44px;
  }
  .github svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .github .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (max-width: 39.99rem) {
    .github {
      min-width: 0;
    }
    .github svg {
      display: none;
    }
    .github .label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }
  nav a.strong {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--highlighter);
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }
  /* On a phone the logo and search share the first row and the site links take the second. */
  @media (max-width: 49.99rem) {
    .site-header[data-variant='docs'] .search {
      flex: 0 0 auto;
      max-width: none;
    }
    .site-header[data-variant='docs'] nav {
      flex: 1 0 100%;
      gap: 4px 20px;
    }
  }
  /* At 320px the four docs links need to share one row, or the header outgrows its bar. */
  @media (max-width: 22rem) {
    .site-header[data-variant='docs'] nav {
      gap: 4px 6px;
      font-size: 13.5px;
    }
  }
</style>
