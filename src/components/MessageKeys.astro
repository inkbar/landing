---
import messages from '../data/messages.json'

// Generated by scripts/messages-table.mjs from the English set in @inkbar/core.
const groups = [...new Set(messages.map((m) => m.group))].map((group) => ({
  group,
  rows: messages.filter((m) => m.group === group),
}))
---

{groups.map(({ group, rows }) => (
  <>
    <h3 id={`messages-${group}`}>
      <code>{group}</code>
    </h3>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Key</th>
            <th>English</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <td>
                <code>
                  {group}.{row.key}
                </code>
                {row.kind === 'function' && ' (function)'}
              </td>
              <td>{row.english}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>
))}

<style>
  .table-wrap {
    max-width: 100%;
    overflow-x: auto;
  }
</style>
