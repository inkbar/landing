---
import messages from '../data/messages.json'

// Generated by scripts/messages-table.mjs from the English set in @inkbar/core.
const groups = [...new Set(messages.map((m) => m.group))].map((group) => ({
  group,
  rows: messages.filter((m) => m.group === group),
}))
---

{groups.map(({ group, rows }) => (
  <>
    <h3 id={`messages-${group}`}>
      <code>{group}</code>
    </h3>
    <table class="message-keys">
      <thead>
        <tr>
          <th>Key</th>
          <th>English</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>
              <code>
                {group}.{row.key}
              </code>
              {row.kind === 'function' && ' (function)'}
            </td>
            <td>{row.english}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </>
))}

<style>
  /* Every group shares one column split, so the tables line up down the page. */
  @media (min-width: 50rem) {
    .message-keys {
      table-layout: fixed;
    }
    .message-keys th:first-child {
      width: 50%;
    }
  }
</style>
