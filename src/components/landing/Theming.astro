---
import { Highlighter, MessageSquare, MousePointer2, Square, ZoomIn } from '@inkbar/icons'

import Icon from '../site/Icon.astro'
---

<section id="theming">
  <div class="container inner">
    <div class="intro">
      <h2>It should look like your product, not ours.</h2>
      <p class="lede">
        Ship the default theme as it is, restyle it with CSS, or render the controls as
        your own components. If your page already defines tokens such as{' '}
        <span class="token">--primary</span> and <span class="token">--radius</span>, the
        theme uses them.
      </p>
    </div>
    <div class="ways">
      <article class="way">
        <div class="stage" aria-hidden="true">
          <div class="bar bar-default">
            <span class="cell">
              <Icon icon={MousePointer2} />
            </span>
            <span class="cell on">
              <Icon icon={Highlighter} />
            </span>
            <span class="cell">
              <Icon icon={MessageSquare} />
            </span>
            <span class="cell">
              <Icon icon={Square} />
            </span>
            <span class="cell">
              <Icon icon={ZoomIn} />
            </span>
          </div>
        </div>
        <h3>Use the default</h3>
        <p>One stylesheet styles the toolbars, popovers and pages, in light and dark.</p>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: Default theme import"
        >import '@inkbar/theme/theme.css'</pre>
      </article>

      <article class="way">
        <div class="stage" aria-hidden="true">
          <div class="bar bar-pill">
            <span class="cell">
              <Icon icon={MousePointer2} />
            </span>
            <span class="cell on">
              <Icon icon={Highlighter} />
            </span>
            <span class="cell">
              <Icon icon={MessageSquare} />
            </span>
            <span class="cell">
              <Icon icon={Square} />
            </span>
            <span class="cell">
              <Icon icon={ZoomIn} />
            </span>
          </div>
        </div>
        <h3>Restyle it with CSS</h3>
        <p>
          Every rule has zero specificity, so yours win without <code>!important</code>.
          Set Inkbar's tokens on any part.
        </p>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: CSS override example"
        >.ink-toolbar &#123;
  --ink-surface: #0d1026;
  --ink-fg: #ffffff;
  --ink-accent: #e4ff4a;
  --ink-accent-fg: #0d1026;
  --ink-radius: 999px;
  border-radius: 999px;
&#125;</pre>
      </article>

      <article class="way">
        <div class="stage" aria-hidden="true">
          <div class="bar bar-square">
            <span class="cell">
              <Icon icon={MousePointer2} />
            </span>
            <span class="cell on">
              <Icon icon={Highlighter} />
            </span>
            <span class="cell">
              <Icon icon={MessageSquare} />
            </span>
            <span class="cell">
              <Icon icon={Square} />
            </span>
            <span class="cell">
              <Icon icon={ZoomIn} />
            </span>
          </div>
        </div>
        <h3>Use your own components</h3>
        <p>
          Render any control as your own button with <code>asChild</code>. It keeps its
          behaviour and its accessible name.
        </p>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: Custom toolbar example"
        >&lt;InkToolbar&gt;
  &lt;InkUndo asChild&gt;
    &lt;YourButton icon="undo" /&gt;
  &lt;/InkUndo&gt;
&lt;/InkToolbar&gt;</pre>
      </article>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--sheet);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(56px, 8vw, 112px);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }
  h2 {
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--body);
  }
  .token {
    font-family: var(--font-mono);
    font-size: 0.9em;
    white-space: nowrap;
  }

  /*
   * One panel, three columns, the same toolbar at the top of each. Each column spans four
   * rows of a shared grid (subgrid), so the toolbars, headings, text and code line up
   * across the columns whatever each one's copy runs to.
   */
  .ways {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--line);
    overflow: hidden;
  }
  @media (min-width: 1120px) {
    .ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto auto auto 1fr;
    }
  }
  .way {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
    background: var(--sheet);
  }
  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 136px;
    padding: 24px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .way h3 {
    padding: 28px 28px 0;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .way p {
    padding: 10px 28px 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--body);
  }
  .way code {
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .way pre {
    align-self: start;
    margin: 20px 28px 28px;
    padding: 16px;
    border-radius: 10px;
    background: var(--ink);
    color: #ffffff;
    --focus-ring: #ffffff;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    overflow-x: auto;
  }
  .way pre:focus-visible {
    outline-offset: -5px;
  }

  /* The same five tools in each column; only the treatment changes. */
  .bar {
    display: flex;
  }
  .cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
  }
  /* The default theme: a plain surface, with the active tool in the accent colour. */
  .bar-default {
    gap: 4px;
    padding: 6px 8px;
    background: var(--sheet);
    box-shadow: 0 1px 2px rgba(13, 16, 38, 0.12);
  }
  .bar-default .cell {
    border-radius: 6px;
  }
  .bar-default .on {
    background: #151820;
    color: #ffffff;
  }
  /* What the CSS sample produces. */
  .bar-pill {
    gap: 4px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff;
  }
  .bar-pill .cell {
    border-radius: 999px;
  }
  .bar-pill .on {
    background: var(--highlighter);
    color: var(--ink);
  }
  /* Someone else's design system. */
  .bar-square {
    border: 2px solid var(--ink);
    background: var(--sheet);
  }
  .bar-square .cell + .cell {
    border-left: 2px solid var(--ink);
  }
  .bar-square .on {
    background: var(--ink);
    color: #ffffff;
  }
</style>
