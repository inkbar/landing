<section id="theming">
  <div class="container inner">
    <div class="intro">
      <h2>It should look like your product, not ours.</h2>
      <p class="lede">
        You can ship the default theme as it is. If you'd rather not, restyle it with CSS
        or render the controls as your own components.
      </p>
    </div>
    <div class="cards">
      <article class="card">
        <h3>Use the default</h3>
        <p>
          Import the theme and the toolbars, popovers and pages get a finished look, in
          light and dark modes.
        </p>
        <div class="stage" aria-hidden="true">
          <div class="bar bar-default">
            <span class="cell cell-default">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 3l14 8-6 2-2 6z"></path>
              </svg>
            </span>
            <span class="cell cell-default on">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M9 11l6-6 4 4-6 6H9v-4zM4 20h8"></path>
              </svg>
            </span>
            <span class="cell cell-default">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 5h14v10H10l-5 4z"></path>
              </svg>
            </span>
            <span class="cell cell-default">
              <svg class="icon" viewBox="0 0 24 24">
                <rect x="4" y="9" width="16" height="6" rx="1" fill="currentColor"></rect>
              </svg>
            </span>
            <span class="cell cell-default">
              <svg class="icon" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="6"></circle>
                <path d="M16 16l4 4M8.5 11h5M11 8.5v5"></path>
              </svg>
            </span>
          </div>
        </div>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: Default theme import"
        >import '@inkbar/theme/theme.css'</pre>
      </article>

      <article class="card">
        <h3>Restyle it with CSS</h3>
        <p>
          The theme's rules have zero specificity and sit in one cascade layer, so your
          CSS overrides them without <code>!important</code>. If your page defines tokens
          such as <span class="token">--primary</span> and{' '}
          <span class="token">--radius</span>, the theme uses them. Annotation colours
          have their own variables.
        </p>
        <div class="stage" aria-hidden="true">
          <div class="bar bar-pill">
            <span class="cell cell-pill">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 3l14 8-6 2-2 6z"></path>
              </svg>
            </span>
            <span class="cell cell-pill on">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M9 11l6-6 4 4-6 6H9v-4zM4 20h8"></path>
              </svg>
            </span>
            <span class="cell cell-pill">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 5h14v10H10l-5 4z"></path>
              </svg>
            </span>
            <span class="cell cell-pill">
              <svg class="icon" viewBox="0 0 24 24">
                <rect x="4" y="9" width="16" height="6" rx="1" fill="currentColor"></rect>
              </svg>
            </span>
            <span class="cell cell-pill">
              <svg class="icon" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="6"></circle>
                <path d="M16 16l4 4M8.5 11h5M11 8.5v5"></path>
              </svg>
            </span>
          </div>
        </div>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: CSS override example"
        >@layer inkbar, utilities;

:root &#123;
  --primary: #0d1026;
  --radius: 999px;
&#125;

[data-ink-root] &#123;
  --ink-highlight: #e4ff4a;
&#125;</pre>
      </article>

      <article class="card">
        <h3>Rebuild it in your design system</h3>
        <p>
          Render any control as your own button with <code>asChild</code>, or wire your
          own to the hooks for tools, zoom, pages and history.
        </p>
        <div class="stage" aria-hidden="true">
          <div class="bar bar-square">
            <span class="cell cell-square">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 3l14 8-6 2-2 6z"></path>
              </svg>
            </span>
            <span class="cell cell-square on">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M9 11l6-6 4 4-6 6H9v-4zM4 20h8"></path>
              </svg>
            </span>
            <span class="cell cell-square">
              <svg class="icon" viewBox="0 0 24 24">
                <path d="M5 5h14v10H10l-5 4z"></path>
              </svg>
            </span>
            <span class="cell cell-square">
              <svg class="icon" viewBox="0 0 24 24">
                <rect x="4" y="9" width="16" height="6" rx="1" fill="currentColor"></rect>
              </svg>
            </span>
            <span class="cell cell-square last">
              <svg class="icon" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="6"></circle>
                <path d="M16 16l4 4M8.5 11h5M11 8.5v5"></path>
              </svg>
            </span>
          </div>
        </div>
        <pre
          tabindex="0"
          role="region"
          aria-label="Code sample: Custom toolbar example"
        >&lt;InkToolbar&gt;
  &lt;InkUndo asChild&gt;
    &lt;YourButton icon="undo" /&gt;
  &lt;/InkUndo&gt;
&lt;/InkToolbar&gt;</pre>
      </article>
    </div>
  </div>
</section>

