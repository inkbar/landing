---
import { codeToHtml, type ThemeRegistration } from 'shiki'

import { defaultFramework, frameworks } from '../../data/snippets'
import inkbarInk from '../../shiki/inkbar-ink.json'
import FrameworkTabs from './FrameworkTabs.svelte'

// The JSON import widens "type" to string, so state the shape Shiki expects.
const theme = inkbarInk as ThemeRegistration

const panels = await Promise.all(
  frameworks.map(async (framework) => ({
    id: framework.id,
    label: framework.label,
    file: framework.file,
    install: framework.install,
    html: await codeToHtml(framework.short, { lang: framework.lang, theme }),
  }))
)
---

<section id="developers">
  <div class="container inner">
    <div class="intro">
      <h2>A few components and one stylesheet.</h2>
      <p class="lede">
        Wrap a viewport in a root and build the toolbar from the controls you want: tools,
        undo and redo, pages and zoom. Each is its own component, so move it, drop it or
        add your own buttons beside it.
      </p>
    </div>
    <div class="body">
      <div class="tabs">
        <FrameworkTabs client:visible panels={panels} initial={defaultFramework} />
      </div>
      <div class="points">
        <div class="point">
          <h3>Typed end to end</h3>
          <p>
            Annotations are plain typed objects with a published JSON Schema. Keep them in
            your own state, or let Inkbar hold them with undo and redo.
          </p>
        </div>
        <div class="point">
          <h3>Headless underneath</h3>
          <p>
            Vue, React and Svelte share one framework-free core. Without a framework, use{' '}
            <code>createViewer</code> and the same controls from <code>@inkbar/core</code>
            .
          </p>
        </div>
        <div class="point">
          <h3>One coordinate system</h3>
          <p>
            Inkbar works in PDF points with the origin bottom-left. You store the same
            numbers that go in the file.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--ink);
    color: #ffffff;
    --focus-ring: #ffffff;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-block: clamp(56px, 8vw, 112px);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 760px;
  }
  h2 {
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--on-ink);
  }
  /* The code leads; the three points run beside it at about its height. */
  .body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 1100px) {
    .body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 56px;
    }
  }
  .tabs {
    min-width: 0;
  }
  .points {
    display: flex;
    flex-direction: column;
  }
  .point {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 24px;
    border-top: 1px solid var(--ink-line);
  }
  .point:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .point h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
  }
  .point p {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--on-ink-muted);
  }
  .point code {
    font-family: var(--font-mono);
    font-size: 14px;
    color: #ffffff;
  }
</style>
