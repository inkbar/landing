---
import { codeToHtml, type ThemeRegistration } from 'shiki'

import { defaultFramework, frameworks } from '../../data/snippets'
import inkbarInk from '../../shiki/inkbar-ink.json'
import FrameworkTabs from './FrameworkTabs.svelte'

// The JSON import widens "type" to string, so state the shape Shiki expects.
const theme = inkbarInk as ThemeRegistration

const panels = await Promise.all(
  frameworks.map(async (framework) => ({
    id: framework.id,
    label: framework.label,
    file: framework.file,
    install: framework.install,
    html: await codeToHtml(framework.code, { lang: framework.lang, theme }),
  }))
)
---

<section id="developers">
  <div class="container row">
    <div class="copy">
      <h2>A few components and one stylesheet.</h2>
      <p class="lede">
        Wrap a viewport in a root, drop in the default toolbar, and you have a working editor. Take
        the toolbar out again when you want your own.
      </p>
      <div class="points">
        <div class="point">
          <h3>Typed end to end</h3>
          <p>
            Annotations are plain typed objects. Keep them in your own state, or let Inkbar hold them
            with undo and redo.
          </p>
        </div>
        <div class="point">
          <h3>Headless underneath</h3>
          <p>
            The components are unstyled primitives on a framework-free core, which the Vue, React and
            Svelte packages share.
          </p>
        </div>
        <div class="point">
          <h3>One coordinate system</h3>
          <p>
            Inkbar works in PDF points with the origin bottom-left. You store the same numbers that go
            in the file.
          </p>
        </div>
      </div>
    </div>
    <div class="tabs">
      <FrameworkTabs client:visible panels={panels} initial={defaultFramework} />
    </div>
  </div>
</section>

<style>
  section {
    background: var(--ink);
    color: #ffffff;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 64px;
    padding-block: clamp(56px, 8vw, 112px);
  }
  .copy {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .tabs {
    flex: 999 1 480px;
    min-width: 0;
  }
  h2 {
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--on-ink);
  }
  .points {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-top: 8px;
  }
  .point {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 20px;
    border-top: 1px solid var(--ink-line);
  }
  .point h3 {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
  }
  .point p {
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--on-ink-muted);
  }
</style>
