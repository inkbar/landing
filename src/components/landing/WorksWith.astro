---
import { url } from '../../lib/url'
---

<div class="container" data-section="works-with">
  <div class="strip">
    <span class="label">Works with</span>
    <span class="name">TypeScript</span>
    <a class="name" href={url('/docs/frameworks/vue/')}>
      Vue
    </a>
    <a class="name" href={url('/docs/frameworks/react/')}>
      React
    </a>
    <a class="name" href={url('/docs/frameworks/svelte/')}>
      Svelte
    </a>
    <a class="name" href={url('/docs/frameworks/plain-dom/')}>
      Plain DOM
    </a>
  </div>
</div>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 40px;
    padding: 36px 0 clamp(56px, 8vw, 104px);
    font-size: 15px;
    color: var(--caption);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  a.name {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  a.name:hover {
    text-decoration-color: currentColor;
  }
</style>
