---
import { url } from '../../lib/url'
import { defaultFramework, frameworks } from '../../data/snippets'

const install =
  frameworks.find((framework) => framework.id === defaultFramework)?.install ?? ''
---

<section id="start">
  <div class="container row">
    <div class="copy">
      <h2>Install it and see.</h2>
      <p>
        You don't need a trial or a sign-up form. Follow the quickstart to put a document
        on screen with the default toolbar.
      </p>
    </div>
    <div class="action">
      <code>
        <span class="prompt" aria-hidden="true">
          $
        </span>
        {install}
      </code>
      <div class="links">
        <a class="text-link" href={url('/docs/quickstart/')}>
          Read the quickstart
        </a>
        <a class="text-link" href="https://github.com/inkbar/inkbar">
          Star on GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background: var(--highlighter);
    color: var(--ink);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 64px;
    padding-block: clamp(56px, 8vw, 104px);
  }
  .copy {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  h2 {
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.03em;
  }
  .copy p {
    max-width: 520px;
    font-size: 18px;
    line-height: 1.55;
  }
  .action {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  code {
    display: block;
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--ink);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 14.5px;
    overflow-wrap: anywhere;
  }
  .prompt {
    margin-right: 10px;
    color: var(--on-ink-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .text-link {
    margin-right: 16px;
    text-decoration-color: currentColor;
  }
  .links .text-link:last-child {
    margin-right: 0;
  }
</style>
