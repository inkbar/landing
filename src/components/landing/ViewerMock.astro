---
import {
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  Hand,
  Highlighter,
  MessageSquare,
  MousePointer2,
  Redo2,
  Square,
  Undo2,
} from '@inkbar/icons'

import Icon from '../site/Icon.astro'
---

<div
  class="container"
  data-section="viewer"
  role="group"
  aria-label="Example: the Inkbar viewer"
>
  <div class="viewer">
    <div class="toolbar" role="toolbar" aria-label="PDF tools">
      <div class="group">
        <button type="button" class="tool" aria-label="View">
          <Icon icon={Hand} />
        </button>
        <button type="button" class="tool" aria-label="Select">
          <Icon icon={MousePointer2} />
        </button>
        <button type="button" class="tool" aria-label="Highlight" aria-pressed="true">
          <Icon icon={Highlighter} />
        </button>
        <button type="button" class="tool" aria-label="Mark for redaction">
          <Icon icon={Square} />
        </button>
        <button type="button" class="tool" aria-label="Add note">
          <Icon icon={MessageSquare} />
        </button>
      </div>
      <span class="divider" aria-hidden="true"></span>
      <div class="group">
        <button type="button" class="tool" aria-label="Undo">
          <Icon icon={Undo2} />
        </button>
        <button type="button" class="tool" aria-label="Redo">
          <Icon icon={Redo2} />
        </button>
      </div>
      <div class="pages">
        <button type="button" class="tool" aria-label="Previous page">
          <Icon icon={ChevronLeft} />
        </button>
        <span class="page-box">3</span>
        <span class="page-of">of 24</span>
        <button type="button" class="tool" aria-label="Next page">
          <Icon icon={ChevronRight} />
        </button>
        <span class="zoom-level">
          Fit width
          <Icon icon={ChevronDown} class="chevron" />
        </span>
      </div>
    </div>
    <div class="body">
      <div class="stage">
        <div class="sheet">
          <div class="doc-meta">SUPPLIER AGREEMENT · PAGE 3 OF 24</div>
          <div class="doc-title">4. Data handling</div>
          <p>
            4.1 The Supplier shall process Customer Data only on documented instructions
            from the Customer, and{' '}
            <span class="hl">shall delete all Customer Data within thirty (30) days</span>{' '}
            of termination.
            <span class="pin" aria-hidden="true">
              <Icon icon={MessageSquare} />
            </span>
          </p>
          <p>
            4.2 Each party shall keep the other's Confidential Information secret and
            shall not disclose it to any third party without prior written consent.
          </p>
          <p>
            4.3 Notices under this clause go to{' '}
            <span class="redact">Jordan Avery, Legal</span>
            <span class="visually-hidden">(marked for redaction)</span> at{' '}
            j.avery@example.com or the address in Schedule 3.
          </p>
        </div>
      </div>
      <aside class="side" aria-label="Popovers">
        <div class="card">
          <div class="card-head">
            <span class="swatch swatch-note"></span>
            <span class="name">Priya S.</span>
            <span class="where">Note · 4.1</span>
          </div>
          <div>Is thirty days enough to cover the backups too?</div>
          <div class="reply">
            <span class="name">Marcus L.</span>
            <span>Backups are in 4.4. Leaving this as is.</span>
          </div>
          <div class="field">Reply…</div>
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  .viewer {
    margin-top: clamp(40px, 6vw, 72px);
    background: var(--sheet);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 30px 60px -30px rgba(13, 16, 38, 0.35);
    overflow: hidden;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--sheet);
  }
  .zoom-level {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    white-space: nowrap;
  }
  .chevron {
    width: 14px;
    height: 14px;
  }
  .pages {
    display: flex;
    align-items: center;
    margin-left: auto;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .page-box {
    padding: 6px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .page-of {
    color: var(--caption);
    margin: 0 4px 0 6px;
  }
  .divider {
    width: 1px;
    height: 24px;
    background: var(--line);
    margin: 0 8px;
  }
  .group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
  }
  .tool {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    padding: 0;
  }
  .tool:hover {
    background: #eceef5;
  }
  .tool[aria-pressed='true'] {
    background: var(--highlighter);
  }
  .tool svg {
    width: 19px;
    height: 19px;
  }
  @media (max-width: 600px) {
    .divider {
      display: none;
    }
    .tool {
      width: 44px;
      height: 44px;
    }
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    background: var(--viewer-ground);
  }
  .stage {
    flex: 999 1 420px;
    min-width: 0;
    padding: clamp(16px, 3vw, 36px);
    display: flex;
    justify-content: center;
    box-sizing: border-box;
  }
  .sheet {
    width: 100%;
    max-width: 640px;
    background: var(--sheet);
    box-shadow: 0 1px 3px rgba(13, 16, 38, 0.18);
    padding: clamp(24px, 4vw, 52px);
    box-sizing: border-box;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 15.5px;
    line-height: 1.75;
    color: #1b1f38;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .doc-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--caption);
  }
  .doc-title {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }
  .hl {
    background: var(--highlighter);
  }
  .pin {
    display: inline-flex;
    vertical-align: middle;
    margin-left: 4px;
    padding: 2px;
    border-radius: 4px;
    background: var(--highlighter);
    border: 1px solid var(--ink);
  }
  .pin svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }
  /* A redaction mark is a tinted, outlined box. The text stays until the file is saved. */
  .redact {
    background: rgba(13, 16, 38, 0.15);
    outline: 2px solid var(--strike);
    outline-offset: 0;
    border-radius: 1px;
  }
  .side {
    flex: 1 1 280px;
    min-width: 0;
    border-left: 1px solid var(--line);
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14px;
    line-height: 1.5;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--sheet);
    box-shadow: 0 8px 20px -12px rgba(13, 16, 38, 0.3);
  }
  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .name {
    font-weight: 600;
  }
  .where {
    color: var(--caption);
  }
  .swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
  }
  .swatch-note {
    background: var(--highlighter);
    border: 1px solid var(--ink);
  }
  .reply {
    padding-left: 12px;
    border-left: 2px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .field {
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--caption);
  }
</style>
