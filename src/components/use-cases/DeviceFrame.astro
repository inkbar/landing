---
// A screenshot in the frame of the screen it was taken on. On a wide screen it sits in a plain
// browser window; below 640px it sits in a phone and the page loads the phone capture instead.
// One <picture> picks the file, so a reader downloads only the image their screen shows. The
// browser dots are neutral and the phone is any phone, not a particular one.
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

interface Props {
  /** A made-up page in the reader's own app. The phone's address bar shows only its host. */
  address: string
  desktop: ImageMetadata
  phone: ImageMetadata
  alt: string
  /** The widths the frame is shown at, for the browser to pick a file. */
  sizes: { desktop: string; phone: string }
  /** `compact` is the overview's: a cropped window on wide screens, a small phone on phones. */
  size?: 'full' | 'compact'
  /** Where the compact window's crop centres, as `x% y%`. */
  focus?: string
  /** The hero screenshot loads at once; the overview's as they scroll in. */
  eager?: boolean
}

const {
  address,
  desktop,
  phone,
  alt,
  sizes,
  size = 'full',
  focus = '50% 50%',
  eager = false,
} = Astro.props
const full = size === 'full'
const [wide, narrow] = await Promise.all([
  getImage({
    src: desktop,
    widths: full ? [720, 1440, 2160] : [640, 1080],
    format: 'webp',
  }),
  getImage({ src: phone, widths: full ? [600, 900, 1170] : [300, 600], format: 'webp' }),
])
const host = address.split('/')[0]
---

<div class:list={['device', size]}>
  <div class="screen">
    <div class="browser-bar" aria-hidden="true">
      <span class="dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="address">
        <svg class="lock" viewBox="0 0 16 16">
          <path d="M5 7V5a3 3 0 0 1 6 0v2M4 7h8v6H4z"></path>
        </svg>
        {address}
      </span>
    </div>
    <div class="status" aria-hidden="true">
      <span class="time">9:30</span>
      <span class="island"></span>
      <span class="icons">
        <svg viewBox="0 0 18 12">
          <rect x="0" y="8" width="3" height="4" rx="1"></rect>
          <rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect>
          <rect x="10" y="3" width="3" height="9" rx="1"></rect>
          <rect x="15" y="0" width="3" height="12" rx="1"></rect>
        </svg>
        <svg viewBox="0 0 16 12">
          <path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0z"></path>
          <path d="M3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.5 1.5a4.4 4.4 0 0 0-6.2 0z"></path>
          <path d="M1.2 4.6a9.6 9.6 0 0 1 13.6 0l-1.5 1.5a7.5 7.5 0 0 0-10.6 0z"></path>
        </svg>
        <svg viewBox="0 0 27 12">
          <rect
            class="battery"
            x="0.5"
            y="0.5"
            width="23"
            height="11"
            rx="3.5"
            fill="none"
            stroke-width="1"
          ></rect>
          <rect x="2" y="2" width="17" height="8" rx="2"></rect>
          <path d="M25 4v4a2 2 0 0 0 0-4z"></path>
        </svg>
      </span>
    </div>
    <div class="view" style={`--focus: ${focus}`}>
      <picture>
        <source
          media="(max-width: 639px)"
          type="image/webp"
          srcset={narrow.srcSet.attribute}
          sizes={sizes.phone}
          width={phone.width}
          height={phone.height}
        />
        <img
          class="shot"
          src={wide.src}
          srcset={wide.srcSet.attribute}
          sizes={sizes.desktop}
          width={desktop.width}
          height={desktop.height}
          alt={alt}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
        />
      </picture>
    </div>
    <div class="phone-bar" aria-hidden="true">
      <span class="pill">
        <svg class="lock" viewBox="0 0 16 16">
          <path d="M5 7V5a3 3 0 0 1 6 0v2M4 7h8v6H4z"></path>
        </svg>
        {host}
      </span>
      <span class="home"></span>
    </div>
  </div>
</div>

<style>
  .screen {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--sheet);
    box-shadow:
      0 1px 2px rgb(13 16 38 / 0.06),
      0 28px 60px -28px rgb(13 16 38 / 0.45);
  }
  .compact .screen {
    box-shadow: 0 18px 40px -26px rgb(13 16 38 / 0.45);
  }
  .status,
  .phone-bar {
    display: none;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .lock {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  /* The browser window. */
  .browser-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .compact .browser-bar {
    gap: 10px;
    padding: 7px 10px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .compact .dots i {
    width: 7px;
    height: 7px;
  }
  .address {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: min(100%, 440px);
    min-width: 0;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--sheet);
    border: 1px solid var(--line);
    color: var(--caption);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .compact .address {
    padding: 3px 10px;
    font-size: 11px;
  }
  .address .lock {
    width: 12px;
    height: 12px;
  }
  /* The overview's window shows a crop round the shot's focal point. */
  .compact .view {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--viewer-ground);
  }
  .compact .shot {
    height: 100%;
    object-fit: cover;
    transform: scale(1.35);
    transform-origin: var(--focus);
  }

  /*
   * The phone. Everything inside scales with the phone's width (cqw), so the hero's phone and
   * the overview's small one keep the same proportions: a status bar, the capture, and the
   * browser's address bar at the bottom, as phone browsers place it.
   */
  @media (max-width: 639px) {
    .device {
      position: relative;
      container-type: inline-size;
      width: min(100%, 300px);
      margin-inline: auto;
      padding: 10px;
      border-radius: 50px;
      background: var(--ink);
      box-shadow:
        inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
        /* Shows the phone's edge where it crosses the ink band. */ 0 0 0 1px
          rgb(255 255 255 / 0.16),
        0 30px 60px -30px rgb(13 16 38 / 0.6);
    }
    .device::before,
    .device::after {
      content: '';
      position: absolute;
      width: 3px;
      background: var(--ink);
    }
    .device::before {
      right: -3px;
      top: 26%;
      height: 12%;
      border-radius: 0 2px 2px 0;
    }
    .device::after {
      left: -3px;
      top: 20%;
      height: 7%;
      border-radius: 2px 0 0 2px;
      box-shadow: 0 calc(var(--volume-gap, 34px)) 0 var(--ink);
    }
    .device.compact {
      width: 100%;
      padding: 4px;
      border-radius: 20px;
      box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / 0.14),
        0 16px 32px -20px rgb(13 16 38 / 0.6);
      --volume-gap: 14px;
    }
    .device.compact::before,
    .device.compact::after {
      width: 2px;
    }
    .device.compact::before {
      right: -2px;
    }
    .device.compact::after {
      left: -2px;
    }
    .screen,
    .compact .screen {
      border: 0;
      border-radius: 41px;
      box-shadow: none;
    }
    .compact .screen {
      border-radius: 16px;
    }
    .browser-bar {
      display: none;
    }
    .status {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      height: 12cqw;
      padding-inline: 8cqw 6.5cqw;
      background: #ffffff;
      color: var(--ink);
      font-size: 4cqw;
      font-weight: 600;
      line-height: 1;
    }
    .island {
      width: 28cqw;
      height: 7.6cqw;
      border-radius: 999px;
      background: #000000;
    }
    .icons {
      justify-self: end;
      display: flex;
      align-items: center;
      gap: 1.4cqw;
    }
    .icons svg {
      height: 3.1cqw;
      width: auto;
      fill: currentColor;
    }
    .icons .battery {
      stroke: currentColor;
      opacity: 0.4;
    }
    .compact .view {
      aspect-ratio: auto;
      background: none;
    }
    .compact .shot {
      height: auto;
      transform: none;
    }
    .phone-bar {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3.2cqw;
      padding: 2.6cqw 4cqw 2cqw;
      border-top: 1px solid var(--line);
      background: var(--paper);
    }
    .pill {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.5cqw;
      width: 100%;
      padding-block: 2.4cqw;
      border-radius: 3.6cqw;
      background: #ffffff;
      color: var(--ink);
      font-size: 3.8cqw;
      line-height: 1.2;
    }
    .pill .lock {
      width: 3.2cqw;
      height: 3.2cqw;
    }
    .home {
      width: 35cqw;
      height: 1.3cqw;
      border-radius: 999px;
      background: var(--ink);
    }
  }
</style>
