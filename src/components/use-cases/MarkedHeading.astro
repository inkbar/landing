---
// A heading marked up like a document, with the tool its page is about: a redaction box, a
// form field, a signature or a highlighter. The mark draws in once when the page loads.
import { splitHeading } from '../../lib/use-case-text'

interface Props {
  text: string
  mark: 'redact' | 'field' | 'signature' | 'highlight'
  level?: 'h1' | 'h2'
}

const { text, mark, level = 'h1' } = Astro.props
const { before, marked, after } = splitHeading(text)
const Tag = level
---

<Tag class="marked-heading">
  {before}
  <span class={`mark mark-${mark}`}>
    {marked}
    {mark === 'signature' && (
      <svg
        class="stroke"
        viewBox="0 0 200 24"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path d="M2 16 C 20 4, 34 22, 52 12 S 86 2, 104 14 S 140 22, 160 10 S 190 6, 198 12" />
      </svg>
    )}
    {mark === 'field' && <span class="caret" aria-hidden="true" />}
  </span>
  {after}
</Tag>

<style>
  .mark {
    position: relative;
    white-space: nowrap;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  /* Highlighter: the swipe from the home page, drawn left to right. */
  .mark-highlight {
    padding: 0 0.12em;
    border-radius: 6px;
    background: linear-gradient(var(--highlighter), var(--highlighter)) no-repeat left
      55% / 100% 80%;
  }

  /* Redaction: an applied redaction box, with the word reversed out so it stays readable. */
  .mark-redact {
    padding: 0 0.14em;
    border-radius: 4px;
    color: var(--paper);
    background: linear-gradient(var(--ink), var(--ink)) no-repeat left / 100% 100%;
  }

  /* Form field: a tinted field with a Ballpoint focus ring and a caret after the text. */
  .mark-field {
    padding: 0 0.16em;
    border-radius: 8px;
    background: #e6ebfe;
    box-shadow: 0 0 0 0.035em var(--ballpoint);
  }
  .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.82em;
    margin-left: 0.06em;
    vertical-align: -0.06em;
    background: var(--ballpoint);
  }

  /* Signature: a pen stroke under the word. */
  .mark-signature .stroke {
    position: absolute;
    left: -0.05em;
    right: -0.15em;
    bottom: -0.1em;
    width: calc(100% + 0.2em);
    height: 0.2em;
    overflow: visible;
  }
  .stroke path {
    fill: none;
    stroke: var(--ballpoint);
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 260;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mark-highlight {
      animation: swipe 700ms 250ms cubic-bezier(0.3, 0.7, 0.3, 1) both;
    }
    .mark-redact {
      animation: swipe-redact 700ms 250ms cubic-bezier(0.3, 0.7, 0.3, 1) both;
    }
    .mark-field {
      animation: focus-ring 500ms 250ms ease-out both;
    }
    .caret {
      animation: blink 1.1s 900ms steps(1) 3;
    }
    .stroke path {
      animation: draw 900ms 250ms cubic-bezier(0.5, 0, 0.3, 1) both;
    }
  }
  @keyframes swipe {
    from {
      background-size: 0% 80%;
    }
  }
  @keyframes swipe-redact {
    from {
      background-size: 0% 100%;
      color: inherit;
    }
    60% {
      color: inherit;
    }
  }
  @keyframes focus-ring {
    from {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 260;
    }
  }
</style>
