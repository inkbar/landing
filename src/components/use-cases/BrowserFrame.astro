---
// A plain browser window round a screenshot, so the viewer reads as part of the reader's own
// web app. The dots are neutral on purpose: it is any browser, not a particular one.
interface Props {
  address: string
  size?: 'full' | 'compact'
}

const { address, size = 'full' } = Astro.props
---

<div class:list={['frame', size]}>
  <div class="bar" aria-hidden="true">
    <span class="dots">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="address">
      <svg viewBox="0 0 16 16">
        <path d="M5 7V5a3 3 0 0 1 6 0v2M4 7h8v6H4z"></path>
      </svg>
      {address}
    </span>
  </div>
  <slot />
</div>

<style>
  .frame {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--sheet);
    box-shadow:
      0 1px 2px rgb(13 16 38 / 0.06),
      0 28px 60px -28px rgb(13 16 38 / 0.45);
  }
  .frame.compact {
    box-shadow: 0 18px 40px -26px rgb(13 16 38 / 0.45);
  }
  .bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .compact .bar {
    gap: 10px;
    padding: 7px 10px;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .compact .dots i {
    width: 7px;
    height: 7px;
  }
  .address {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 6px;
    max-width: min(100%, 440px);
    min-width: 0;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--sheet);
    border: 1px solid var(--line);
    color: var(--caption);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .compact .address {
    padding: 3px 10px;
    font-size: 11px;
  }
  .address svg {
    flex: none;
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .frame :global(img) {
    display: block;
  }
</style>
