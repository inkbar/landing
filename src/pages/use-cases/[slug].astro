---
// A use-case page: the outcome and a real screenshot first, for someone deciding whether the
// job can be built, then what it takes, a short sample and the guide that goes further.
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'

import Landing from '../../layouts/Landing.astro'
import { url } from '../../lib/url'

export async function getStaticPaths() {
  const entries = await getCollection('useCases')
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
const { data } = entry
const guideNames = {
  redaction: 'Redaction',
  forms: 'Forms',
  signatures: 'Signatures',
  annotations: 'Annotations',
} as const
---

<Landing title={data.title} description={data.description}>
  <article class="container use-case">
    <header>
      <h1>{data.heading}</h1>
      <p class="lede">{data.lede}</p>
    </header>
    <Image
      class="shot"
      src={data.screenshot}
      alt={data.alt}
      widths={[720, 1440, 2160]}
      sizes="(min-width: 1040px) 960px, calc(100vw - 2 * var(--gutter, 16px))"
      loading="eager"
    />
    <div class="body">
      <Content />
    </div>
    <p class="next">
      <a class="text-link" href={url(`/docs/guides/${data.guide}/`)}>
        Read the {guideNames[data.guide]} guide
      </a>
      <a class="text-link" href="https://sandbox.inkbar.dev">
        Try it in the sandbox
      </a>
    </p>
  </article>
</Landing>

<style>
  .use-case {
    max-width: 1040px;
    padding-block: clamp(48px, 7vw, 104px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }
  header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 780px;
  }
  h1 {
    font-size: clamp(36px, 5.2vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    overflow-wrap: break-word;
  }
  .lede {
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: var(--body);
  }
  .shot {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 24px 48px -24px rgb(15 23 42 / 0.25);
  }
  .body {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--body);
  }
  .body :global(h2) {
    margin-top: 24px;
    font-size: clamp(24px, 2.6vw, 30px);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .body :global(ul) {
    margin: 0;
    padding-left: 1.25em;
  }
  .body :global(li + li) {
    margin-top: 6px;
  }
  .body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }
  .body :global(pre) {
    overflow-x: auto;
    padding: 20px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.6;
  }
  .body :global(a) {
    color: var(--ink);
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: 17px;
  }
</style>
