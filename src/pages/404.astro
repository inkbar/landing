---
import { url } from '../lib/url'
import Landing from '../layouts/Landing.astro'
---

<Landing
  title="Page not found · Inkbar"
  description="This page does not exist."
  indexable={false}
>
  <section class="container not-found">
    <h1>Page not found</h1>
    <p>
      That address doesn't match a page. Go to the{' '}
      <a class="text-link" href={url('/')}>
        home page
      </a>{' '}
      or the
      <a class="text-link" href={url('/docs/quickstart/')}>
        Quickstart
      </a>
      .
    </p>
  </section>
</Landing>

<style>
  .not-found {
    padding-block: clamp(56px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 76px);
    letter-spacing: -0.03em;
  }
  p {
    font-size: 18px;
    color: var(--body);
  }
</style>
